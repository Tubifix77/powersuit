menu "Powersuit node_limb Configuration"

    choice PS_NODE_ID
        prompt "Limb node identity"
        default PS_NODE_IS_ARM_RIGHT
        help
            One firmware image serves Nodes 1-4 (docs/network-map.md section 1
            node registry); this choice selects which bench harness and board
            table (board_limb.h) the build targets. Joints per limb: arms
            elbow=0/wrist=1, legs hip=0/knee=1.

        config PS_NODE_IS_ARM_RIGHT
            bool "arm_right  (node 1, CAN bus 1)"
        config PS_NODE_IS_ARM_LEFT
            bool "arm_left   (node 2, CAN bus 1)"
        config PS_NODE_IS_LEG_RIGHT
            bool "leg_right  (node 3, CAN bus 2)"
        config PS_NODE_IS_LEG_LEFT
            bool "leg_left   (node 4, CAN bus 2)"
    endchoice

    config PS_LIMB_NODE_ID
        int
        default 1 if PS_NODE_IS_ARM_RIGHT
        default 2 if PS_NODE_IS_ARM_LEFT
        default 3 if PS_NODE_IS_LEG_RIGHT
        default 4 if PS_NODE_IS_LEG_LEFT
        help
            Numeric node ID (powersuit_proto/can_id.h PS_NODE_ARM_R..LEG_L),
            used verbatim as the CAN source address and to pick the board
            table / micro-ROS node name in app_main.c.

    config PS_LIMB_BENCH
        bool "Bench mode: no motor driver, encoders or current sense"
        default n
        help
            Runs the real limb firmware on a bare DevKitC-1 with only a CAN
            transceiver attached (docs/bringup.md Appendix A). The motor driver
            (MCPWM), encoder SPI and ADC are not initialised: the joints read as
            at rest with zero current, and joint_write() counts the ticks on
            which the safety gate WOULD have energised a joint instead of driving
            gates. Everything else is the real code: the 1 kHz control loop on
            core 1, PIDs and FOC maths, ps_safety, 100 Hz TELEM on core 0, the
            IMU on I2C (allowed to be absent).

            Needed because board_limb.h's pin map cannot run on this board: it
            assigns GPIO 22-25, which do not exist on the ESP32-S3, and 35-37,
            the octal PSRAM on N16R8 (see the note at the top of board_limb.h).

    config PS_LIMB_BENCH_CAN_TX_GPIO
        int "Bench TWAI TX GPIO"
        depends on PS_LIMB_BENCH
        default 4

    config PS_LIMB_BENCH_CAN_RX_GPIO
        int "Bench TWAI RX GPIO"
        depends on PS_LIMB_BENCH
        default 5

endmenu
